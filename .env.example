# Copy to .env and fill in. .env is gitignored — never commit keys.

# Instantly API v2 key (Settings -> Integrations -> API keys). Read scopes are enough.
INSTANTLY_API_KEY=

# Optional: MXToolbox API key for the domain blacklist check in inbox_health.py
# (free plan: 64 lookups/day). Without it the blacklist check reports "NOT checked".
MX_TOOLBOX_API_KEY=
